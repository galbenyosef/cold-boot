{
  "name": "cold-boot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "check:zfight": "node scripts/check-zfight.mjs",
    "check:doors": "node scripts/check-doors.mjs",
    "check:reach": "node scripts/check-reach.mjs",
    "check:wreck": "node scripts/check-wreck.mjs",
    "check:decals": "node scripts/check-decals.mjs",
    "check:chain": "node scripts/check-chain.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:cutscene": "node scripts/check-cutscene.mjs",
    "check": "node scripts/check-zfight.mjs && node scripts/check-doors.mjs && node scripts/check-reach.mjs && node scripts/check-decals.mjs && node scripts/check-wreck.mjs && node scripts/check-chain.mjs && node scripts/check-nav.mjs && node scripts/check-cutscene.mjs",
    "voice": "uv run --project tools/voice coldvoice gen",
    "voice:cast": "uv run --project tools/voice coldvoice cast",
    "voice:check": "uv run --project tools/voice coldvoice check",
    "voice:report": "uv run --project tools/voice coldvoice report"
  },
  "dependencies": {
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
